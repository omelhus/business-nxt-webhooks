{
  "name": "business-nxt-webhooks",
  "version": "1.0.0",
  "description": "Demo Project for Business NXT Webhooks",
  "type": "module",
  "scripts": {
    "dev:codegen": "graphql-codegen --watch --config tools/codegen.ts",
    "dev:sst": "sst dev",
    "dev": "pnpm run --parallel \"/^dev:.*/\"",
    "codegen": "graphql-codegen --config tools/codegen.ts",
    "update-schema": "tsx -r dotenv/config tools/update-schema.ts"
  },
  "keywords": [],
  "author": "Ole Melhus",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "sst": "^4.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.2",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-tools/load": "^8.1.17",
    "@graphql-tools/url-loader": "^9.1.10",
    "@parcel/watcher": "^2.6.0",
    "@tsconfig/node18": "^18.2.7",
    "@types/aws-lambda": "8.10.163",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
